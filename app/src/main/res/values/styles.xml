<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主题：支持白天 / 黑夜（AppCompat DayNight，兼容 API 14） -->
    <style name="Theme.QiuReader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorControlHighlight">@color/brand_light</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 阅读页主题 -->
    <style name="Theme.QiuReader.Reader" parent="Theme.QiuReader">
        <item name="android:windowBackground">@color/reader_bg</item>
    </style>

    <!-- 设置页单选项（圆圈 + 文字，整行可点） -->
    <style name="Widget.QiuReader.RadioOption" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_option_row</item>
        <item name="android:button">@drawable/selector_theme_radio</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/theme_option_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 主按钮 -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
